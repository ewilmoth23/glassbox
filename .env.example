# Glassbox configuration — copy to .env and fill in.
#   cp .env.example .env
#
# db.py looks for .env.glassbox, then .env, in this directory (and finally
# .env.glassbox in the parent directory, for legacy deployments). First hit wins.
# Never commit the filled-in file: .env and .env.* are gitignored.

# ─── Postgres (required) ───────────────────────────────────────────────────
# Either set GLASSBOX_DB_URL, or the five discrete keys below. URL wins.
# See docs/POSTGRES_SETUP.md for installing Postgres with PostGIS, TimescaleDB
# and pgvector, then creating the schema from infra/postgres/init.sql.
GLASSBOX_DB_URL=postgresql://glassbox:CHANGEME@127.0.0.1:5432/glassbox
# GLASSBOX_DB_HOST=127.0.0.1
# GLASSBOX_DB_PORT=5432
# GLASSBOX_DB_NAME=glassbox
# GLASSBOX_DB_USER=glassbox
# GLASSBOX_DB_PASSWORD=

# ─── Source credentials (all optional) ─────────────────────────────────────
# Every ingester that needs a key stays disabled until you supply one. The
# server runs on whatever subset you hold rights to — no key, no ingester, no
# error. Add only what you have.

# Global AIS vessel firehose — https://aisstream.io
# AISSTREAM_API_KEY=

# Cesium Ion token, served to the 3D client by /api/v1/cesium-token
# CESIUM_ION_TOKEN_MEWR=

# ─── Outbound email for the /signals daily digest (optional) ───────────────
# Without these the digest pipeline is inert; nothing else is affected.
# GLASSBOX_SMTP_PROVIDER=postmark
# GLASSBOX_SMTP_TOKEN=
# GLASSBOX_DIGEST_FROM=
