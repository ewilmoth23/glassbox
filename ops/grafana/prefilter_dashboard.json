{
  "title": "Glassbox Prefilter — GDELT Bulk",
  "uid": "glassbox-prefilter",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["glassbox", "prefilter", "gdelt"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Daemon restarts",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "changes(glassbox_prefilter_pass_total[5m]) == 0 unless on() glassbox_prefilter_pass_total",
        "titleFormat": "process restart",
        "step": "1m"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total events processed",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "glassbox_prefilter_pass_total + sum(glassbox_prefilter_drop_total)",
          "legendFormat": "events seen"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pass rate (last hour)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "green",  "value": 0.005 },
              { "color": "yellow", "value": 0.10 },
              { "color": "red",    "value": 0.25 }
            ]
          },
          "min": 0,
          "max": 0.30
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(glassbox_prefilter_pass_total[1h]) / (rate(glassbox_prefilter_pass_total[1h]) + sum(rate(glassbox_prefilter_drop_total[1h])))",
          "legendFormat": "pass / total"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue depth (% full)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red",    "value": 0.9 }
            ]
          },
          "min": 0,
          "max": 1.0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "glassbox_prefilter_queue_depth / glassbox_prefilter_queue_max_depth",
          "legendFormat": "depth / max"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Throughput (events/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * (rate(glassbox_prefilter_pass_total[5m]) + sum(rate(glassbox_prefilter_drop_total[5m])))",
          "legendFormat": "events/min"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Drops per second by rule",
      "description": "Which rule is dropping events. Stacked. A spike on one rule indicates either an upstream feed shift or a config drift.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(glassbox_prefilter_drop_total[5m])",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Drops per second by structured reason",
      "description": "Same data, sliced by structured reason instead of rule name. Useful for tracking 'duplicate' (in-process dedup health) vs. 'category_not_allowed' (upstream feed mix).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(glassbox_prefilter_drop_by_reason_total[5m])",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Pass / drop rate (events/sec)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(glassbox_prefilter_pass_total[5m])",
          "legendFormat": "pass"
        },
        {
          "refId": "B",
          "expr": "sum(rate(glassbox_prefilter_drop_total[5m]))",
          "legendFormat": "drop (all rules)"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Queue depth + overflow rate",
      "description": "Queue depth tracks how many passing events are buffered for the (still-unbuilt) LLM extraction worker. tail_dropped + new_event_dropped fire when capacity is exceeded — sustained non-zero values mean operators should raise queue.max_depth or accept the lossiness.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "glassbox_prefilter_queue_depth",
          "legendFormat": "depth"
        },
        {
          "refId": "B",
          "expr": "glassbox_prefilter_queue_max_depth",
          "legendFormat": "max"
        },
        {
          "refId": "C",
          "expr": "rate(glassbox_prefilter_queue_tail_dropped_total[5m])",
          "legendFormat": "tail-drop /sec"
        },
        {
          "refId": "D",
          "expr": "rate(glassbox_prefilter_queue_new_event_dropped_total[5m])",
          "legendFormat": "new-event-drop /sec"
        }
      ]
    },
    {
      "id": 30,
      "type": "heatmap",
      "title": "Priority score histogram",
      "description": "Distribution of priority scores assigned to passing events. Shifts indicate scoring config drift or upstream-mix change.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "options": {
        "calculate": false,
        "yAxis": { "axisLabel": "priority", "decimals": 1, "min": 0, "max": 1 }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(glassbox_prefilter_priority_score_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "A/B shadow — confusion matrix (events/sec)",
      "description": "Only meaningful when the daemon is running with GLASSBOX_PREFILTER_SHADOW_CONFIG set. agree_pass + agree_drop should dominate; primary_pass_only + primary_drop_only quantify how strict the candidate config is vs. production.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "agree_pass" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "agree_drop" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "primary_pass_only" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "primary_drop_only" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(glassbox_prefilter_shadow_outcome_total[5m])",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Shadow agreement rate",
      "description": "(agree_pass + agree_drop) / total. 1.0 = shadow is identical to primary; lower = the config is meaningfully diverging.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "red",   "value": 0.99 }
            ]
          },
          "min": 0,
          "max": 1.0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(glassbox_prefilter_shadow_outcome_total{outcome=\"agree_pass\"}[1h])) + sum(increase(glassbox_prefilter_shadow_outcome_total{outcome=\"agree_drop\"}[1h]))) / sum(increase(glassbox_prefilter_shadow_outcome_total[1h]))",
          "legendFormat": "1h agreement"
        }
      ]
    },
    {
      "id": 42,
      "type": "stat",
      "title": "Shadow Δ pass rate",
      "description": "How much the shadow's pass rate differs from primary's. Positive = shadow passes MORE (more permissive); negative = stricter. Compute on a 1h window so per-cycle noise is smoothed.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(glassbox_prefilter_shadow_outcome_total{outcome=~\"agree_pass|primary_drop_only\"}[1h])) - sum(increase(glassbox_prefilter_shadow_outcome_total{outcome=~\"agree_pass|primary_pass_only\"}[1h]))) / sum(increase(glassbox_prefilter_shadow_outcome_total[1h]))",
          "legendFormat": "shadow_pass - primary_pass"
        }
      ]
    }
  ]
}
